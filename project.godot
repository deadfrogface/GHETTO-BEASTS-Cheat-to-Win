; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ghetto Beasts: DNA & Corruption"
config/description="Cel-shaded Cyberpunk-Rundenkampf mit Yu-Gi-Oh-Karten-Summons, CRISPR-Mutationen und Trainer-Sabotage."
run/main_scene="res://scenes/district/main_district.tscn"
config/features=PackedStringArray("4.3", "C#", "Mobile", "Forward Plus")

[autoload]

GameManager="*res://scripts/Core/GameManager.cs"
AssetPipeline="*res://scripts/Core/AssetPipeline.cs"
AudioBus="*res://scripts/Audio/AudioBus.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[dotnet]

project/assembly_name="GhettoBeasts"

[editor]

run/main_run_args=""

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

; Desktop default: Forward+. For Android/iOS exports prefer Vulkan Mobile:
;   Project → Project Settings → Rendering → Renderer → Rendering Method = mobile
;   (or set rendering/renderer/rendering_method="mobile" for mobile export presets)
; Keep MSAA modest on mobile; cel/outline shaders are Mobile-friendly (no heavy PBR).
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
